# Copy to .env and fill in. .env is never committed.
GEMINI_API_KEY=
# The chat's models, first choice first (python check_models.py shows which work for your key)
KARGONAUT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
# The paperwork agent's models (optional)
# KARGONAUT_PAPERWORK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# Where the database lives (optional; default data/kargonaut.db)
# KARGONAUT_DB=
# 0 = don't create the simulated demo accounts when the database is empty
# KARGONAUT_DEMO_SEED=1
# 1 behind HTTPS (the cloud): the login cookie is only sent over HTTPS
# KARGONAUT_SECURE_COOKIE=0
