    },
    {
      "id": "draft-full-confirm", "category": "drafts", "as": "shipper",
      "origin": "Everything given: a draft (not a posted load), then the user's Confirm, then the assistant knows",
      "turns": [
        {"say": "ხვალ თბილისიდან ბათუმში 3 ტონა ავეჯი უნდა გავგზავნო, Box truck-ით, 500 ლარად", "expect": {
          "tools_called": ["propose_load"],
