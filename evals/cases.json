        {"say": "კარგი, მერაბი დაჯავშნე", "expect": {
          "reply_matches": ["მიღება"], "reply_not_matches": ["დაჯავშნილია|დავჯავშნე"]}}
      ]
    },
    {
      "id": "my-loads", "category": "loads", "as": "shipper",
