          "tools_called": ["propose_offer"], "tool_args": {"propose_offer": {"load_id": 8, "price_gel": 850}},
          "draft_fields": {"draft.load_id": 8, "draft.price_gel": 850},
          "reply_matches": ["დადასტურ"], "reply_not_matches": ["შეთავაზება გაიგზავნა|გავუგზავნე"],
          "numbers_grounded": true}},
        {"event": "confirm_last_draft"},
        {"say": "რა შეთავაზებები მაქვს გაგზავნილი?", "expect": {
