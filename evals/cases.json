          "draft_fields": {"draft.origin_city": "Tbilisi", "draft.destination_city": "Batumi", "draft.weight_kg": 3000,
                           "draft.price_gel": 500, "draft.pickup_date": "{today+1}"},
          "reply_matches": ["დადასტურ"], "reply_not_matches": ["გამოქვეყნდა|დაემატა|შევინახე"],
          "numbers_grounded": true}},
        {"event": "confirm_last_draft"},
        {"say": "რამდენი ტვირთი მაქვს ახლა ღია?", "expect": {
          "tools_called": ["my_loads"], "reply_contains_any": ["4", "ოთხ"], "numbers_grounded": true}}
      ]
    },
    {
      "id": "draft-no-price", "category": "drafts", "as": "shipper",
