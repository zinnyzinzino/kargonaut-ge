        "reply_numbers": [900, 1030], "reply_matches": ["ხარჯ|დაბალ|ნაკლებ"], "numbers_grounded": true}}]
    },
    {
      "id": "price-unknown-city", "category": "price", "as": "shipper",
      "origin": "A city we don't serve: no invented price",
      "turns": [{"say": "ზუგდიდიდან თბილისში 5 ტონა რა ღირს?", "expect": {
        "reply_matches": ["ზუგდიდ"], "reply_not_matches": ["\\d{3,}\\s*(₾|ლარ)"], "numbers_grounded": true}}]
    },
    {
