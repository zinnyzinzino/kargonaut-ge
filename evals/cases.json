    },
    {
      "id": "vehicles-nearby", "category": "vehicles", "as": "shipper",
      "origin": "Free vehicles near a city: counts and distances, never a driver's phone",
      "turns": [{"say": "ქუთაისში არის თავისუფალი მანქანები 3 ტონისთვის?", "expect": {
        "tools_called": ["available_vehicles"],
        "tool_args": {"available_vehicles": {"city_name": "Kutaisi", "weight_kg": 3000}},
        "reply_not_contains": ["5990000"], "numbers_grounded": true}}]
    },
    {
      "id": "english-input", "category": "language", "as": "shipper",
      "origin": "The site is Georgian only: an English question still gets a Georgian answer",
      "turns": [{"say": "How much does it cost to send 5 tons from Kutaisi to Tbilisi?", "expect": {
        "tools_called": ["estimate_price"], "reply_numbers": [610, 700], "numbers_grounded": true}}]
    },
    {
      "id": "driver-best-load", "category": "loads", "as": "driver",
      "origin": "The best load is the one Python ranked first (what the driver keeps)",
      "turns": [{"say": "რომელი ტვირთი მაწყობს ყველაზე მეტად?", "expect": {
