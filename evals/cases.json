{
  "about": "The two assistants' exam. Every case runs on a fresh copy of the simulated demo data (seed_demo.py). 'as' says whose assistant answers: shipper = ნინო ბერიძე (599000001, loads №1, №2, №9), driver = ლევან გელაშვილი (599000005, a Dry van, 18 t, in Tbilisi). Expected numbers were computed from the demo data on 26 Nov 2026 (see evals/README.md).",
  "users": {"shipper": "599000001", "driver": "599000005"},
  "cases": [
    {
      "id": "price-types-5t", "category": "price", "as": "shipper",
      "origin": "No truck type given: compare the types that can carry it, name the cheapest",
      "turns": [{"say": "რა ღირს 5 ტონის გაგზავნა ქუთაისიდან თბილისში?", "expect": {
        "tools_called": ["estimate_price"],
        "tool_args": {"estimate_price": {"origin_city": "Kutaisi", "destination_city": "Tbilisi", "weight_kg": 5000}},
        "reply_contains_all": ["Dry van"], "reply_numbers": [610, 700], "numbers_grounded": true}}]
    },
    {
      "id": "price-verdict-low", "category": "price", "as": "shipper",
      "origin": "A price the user has in mind: say it doesn't cover costs and give the fair range",
